{
  "name": "sahajlipi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free Roman Nepali to Unicode typing prototype",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dom": {
      "types": "./src/dom.d.ts",
      "default": "./src/dom.js"
    }
  },
  "types": "./src/index.d.ts",
  "scripts": {
    "test": "node --test",
    "benchmark": "node benchmark/run.js",
    "demo": "python3 -m http.server 4173 --bind 127.0.0.1",
    "demo:lan": "python3 -m http.server 4173 --bind",
    "benchmark:aksharantar": "node benchmark/aksharantar.js",
    "benchmark:sentence-queue": "node benchmark/sentence-review.js",
    "benchmark:review-batch": "node benchmark/review-batch.js",
    "test:browser": "node tools/build-examples.js && playwright test",
    "test:browser:report": "playwright show-report",
    "verify:package": "node tools/verify-package.js",
    "examples:build": "node tools/build-examples.js",
    "examples:serve": "python3 -m http.server 4177 --bind 127.0.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojastechnologies/sahajlipi.git"
  },
  "homepage": "https://github.com/ojastechnologies/sahajlipi#readme",
  "bugs": {
    "url": "https://github.com/ojastechnologies/sahajlipi/issues"
  },
  "files": [
    "src/",
    "LICENSE",
    "LICENSES/",
    "NOTICE"
  ]
}
