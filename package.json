{
  "name": "sahajlipi",
  "version": "0.1.0-alpha.2",
  "private": false,
  "type": "module",
  "description": "Dependency-free Roman Nepali to Unicode typing engine and browser input adapters",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dom": {
      "types": "./src/dom.d.ts",
      "default": "./src/dom.js"
    }
  },
  "types": "./src/index.d.ts",
  "scripts": {
    "test": "node --test",
    "benchmark": "node benchmark/run.js",
    "demo": "npm run site:build && python3 tools/serve-site.py --port 4173",
    "demo:lan": "npm run site:build && python3 tools/serve-site.py --port 4173 --bind",
    "benchmark:aksharantar": "node benchmark/aksharantar.js",
    "benchmark:sentence-queue": "node benchmark/sentence-review.js",
    "benchmark:review-batch": "node benchmark/review-batch.js",
    "benchmark:source-reviewed": "node benchmark/source-reviewed.js",
    "test:browser": "node tools/build-examples.js && playwright test",
    "test:browser:report": "playwright show-report",
    "verify:package": "node tools/verify-package.js",
    "examples:build": "node tools/build-examples.js",
    "examples:serve": "python3 -m http.server 4177 --bind 127.0.0.1",
    "site:dev": "node tools/prepare-site.js && vitepress dev website --host 127.0.0.1 --port 4178",
    "site:build": "node tools/prepare-site.js && vitepress build website",
    "site:check": "node tools/verify-site.js",
    "site:preview": "python3 tools/serve-site.py --port 4178",
    "test:site": "npm run site:build && npm run site:check && playwright test -c playwright.site.config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojastechnologies/sahajlipi.git"
  },
  "homepage": "https://ojastechnologies.github.io/sahajlipi/",
  "bugs": {
    "url": "https://github.com/ojastechnologies/sahajlipi/issues"
  },
  "files": [
    "src/",
    "LICENSE",
    "LICENSES/",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Mahesh Nepal",
    "url": "https://github.com/manepal"
  },
  "keywords": [
    "nepali",
    "nepali-typing",
    "roman-nepali",
    "transliteration",
    "devanagari",
    "unicode",
    "keyboard",
    "input-method"
  ]
}
